{
  "serverInfo": {
    "name": "Abinomics Reference",
    "version": "1.1.0"
  },
  "authentication": {
    "required": false,
    "schemes": [
      "bearer"
    ],
    "description": "Optional API key (Authorization: Bearer abn_... or X-API-Key). Anonymous: 100 tool calls/day per IP. Free key, paid plans (Developer $9, Pro $19, Business $99/month) and prepaid credits; quota exhaustion returns 402 with payment instructions. Billing tools are not metered. After the quota is exhausted, pay $0.001 USDC per request on Base with x402 (PAYMENT-SIGNATURE / X-PAYMENT). Discovery: https://abinomics.com/api/v1/billing/x402."
  },
  "tools": [
    {
      "name": "define_term",
      "title": "Define a financial term",
      "description": "Get the definition of a finance or economics term by its name or abbreviation (e.g. \"ETF\", \"APR\", \"inflation\", \"put option\"). Matching ignores case, accents and punctuation, accepts English names on any edition, and tolerates small typos. Returns the best entry with its full definition, aliases, category, related terms, translation status and canonical URL to cite, plus alternative candidates. If several entries share the exact name, returns ambiguous=true with candidates.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Term name or abbreviation to define."
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "af",
              "ar",
              "be",
              "bg",
              "ca",
              "zh-CN",
              "zh-TW",
              "hr",
              "cs",
              "da",
              "nl",
              "tl",
              "fi",
              "fr",
              "de",
              "el",
              "iw",
              "hi",
              "hu",
              "is",
              "id",
              "ga",
              "it",
              "ja",
              "ko",
              "no",
              "fa",
              "pl",
              "pt",
              "ro",
              "ru",
              "sr",
              "es",
              "sv",
              "th"
            ],
            "default": "en",
            "description": "Language code of the dictionary edition (e.g. en, es, de, fr, ja, zh-CN). Use list_languages for names."
          }
        },
        "required": [
          "term"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "title": "Define a financial term"
      }
    },
