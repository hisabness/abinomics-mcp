      }
    },
    {
      "name": "create_checkout",
      "title": "Create a checkout link for a plan or credits",
      "description": "Create a Stripe Checkout link to buy a plan (plan: developer|pro|business) or prepaid credits (pack: credits_10k|credits_100k|credits_1m). Returns checkout_url: give it to your human to pay; nothing is charged by this call. If this MCP connection sends an API key, the purchase upgrades/credits that key; otherwise a new key is issued after payment (retrieve it with check_checkout). Not metered.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "string",
            "enum": [
              "developer",
              "pro",
              "business"
            ],
            "description": "Monthly plan to subscribe to."
          },
          "pack": {
            "type": "string",
            "enum": [
              "credits_10k",
              "credits_100k",
              "credits_1m"
            ],
            "description": "One-time prepaid credit pack."
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Optional email of the payer (pre-fills checkout, receives the receipt)."
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "title": "Create checkout link"
      }
    },
    {
      "name": "check_checkout",
      "title": "Check a checkout",
      "description": "Check whether a checkout created with create_checkout has been paid. Once paid returns the key prefix, plan tier and credits, plus the new api_key if the purchase issued one (available 24 hours). Poll every few seconds. Not metered.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^cs_(test|live)_[A-Za-z0-9]+$",
            "description": "session_id from create_checkout."
          }
        },
        "required": [
          "session_id"
